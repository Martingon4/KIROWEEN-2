{
  "name": "fork-the-city",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "configure:local": "node scripts/configure-local-env.mjs",
    "provision:local": "node --env-file-if-exists=.env.local scripts/provision-local-users.mjs",
    "smoke:clean": "node scripts/smoke-clean-clone.mjs",
    "format": "prettier --write .",
    "generate:solar": "node scripts/generate-solar-scenarios.mjs",
    "check:solar": "node scripts/generate-solar-scenarios.mjs --check",
    "generate:support": "node scripts/generate-support-properties.mjs",
    "check:support": "node scripts/generate-support-properties.mjs --check",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run check:solar && npm run check:support && npm run build",
    "check:ci": "npm run check && npm run test:db && npm run test:e2e"
  },
  "dependencies": {
    "@next/env": "^16.4.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "pmtiles": "^4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/suncalc": "^1.9.2",
    "suncalc": "1.9.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.11.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "description": "Versioned, reviewable community proposals for real public places.",
  "license": "MIT",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  }
}
