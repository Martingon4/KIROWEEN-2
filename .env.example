# Public browser configuration (safe identifiers, never secret keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. Leave blank to use the local schematic fallback.
NEXT_PUBLIC_MAP_STYLE_URL=

# Server-only configuration
APP_ALLOWED_ORIGINS=http://localhost:3000

# Local provisioning only. Put real local values in your shell or .env.local.
FTC_PARTICIPANT_EMAIL=participant@example.test
FTC_PARTICIPANT_PASSWORD=replace-with-a-local-password
FTC_COORDINATOR_EMAIL=coordinator@example.test
FTC_COORDINATOR_PASSWORD=replace-with-a-different-local-password
FTC_MODERATOR_EMAIL=moderator@example.test
FTC_MODERATOR_PASSWORD=replace-with-another-local-password
